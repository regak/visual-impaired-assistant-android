<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Simu (phone) -->
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.WRITE_CONTACTS" />
    <uses-permission android:name="android.permission.PROCESS_OUTGOING_CALLS" />

    <!-- Ujumbe (SMS) -->
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.RECEIVE_SMS" />

    <!-- Voice input (ASR) + TTS feedback -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Required on Android 11+ (API 30+) package-visibility filtering:
         without this, TextToSpeech's internal PackageManager query for an
         available TTS engine silently fails to resolve any service, so
         TextToSpeech never speaks even though init()'s onInit callback
         may still report SUCCESS. See
         https://developer.android.com/reference/android/speech/tts/TextToSpeech -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/Theme.VisualImpairedAssistant"
        android:supportsRtl="true">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.VisualImpairedAssistant">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Phase 3 (see PLAN.md): BroadcastReceivers for incoming/outgoing
             calls and incoming SMS, routed through this app's own UI
             (TTS-announced) instead of the system dialer/messaging UI,
             matching the original thesis behavior. Registered here once
             Phase 3 lands; left as a comment, not a stub receiver class,
             so the manifest does not reference a class that does not
             exist yet (would fail the manifest merger at compile time). -->

    </application>

</manifest>
